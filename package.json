{
  "name": "dsh-devrel-toolkit",
  "version": "0.0.1",
  "description": "A DeepSeek Harness plugin that turns raw developer feedback into a triage checklist.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./github-issues": "./dist/github-issues.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "dist/*.js",
    "cordis.patch.yml",
    "examples/github-issues/cordis.yml",
    "docs/github-issues.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Mian-mian-hub/dsh-devrel-toolkit.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "test": "node --test \"test/*.test.ts\"",
    "test:bundle": "node --test test/bundle-install.test.mjs",
    "check": "node scripts/check-install.mjs",
    "check:config": "dsh web --dump-config",
    "start": "dsh web",
    "dev": "dsh web --patch ./cordis.yml",
    "start:issues": "node --env-file-if-exists=.env.local node_modules/@deepseek-ai/dsh/lib/bin.js web --patch ./examples/github-issues/cordis.yml",
    "demo:issue": "node --env-file-if-exists=.env.local scripts/send-test-issue.mjs",
    "setup:issues": "node scripts/setup-issues.mjs",
    "connect:github": "node --env-file-if-exists=.env.local scripts/connect-github.mjs"
  },
  "engines": {
    "node": ">=22.18",
    "dsh": "0.1.7-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-tools": "0.1.7-rc.2",
    "@deepseek-ai/dsh-webhook": "0.1.7-rc.2",
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-webhook": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh": "0.1.7-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.7-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.7-rc.2",
    "@deepseek-ai/dsh-webhook": "0.1.7-rc.2",
    "@deepseek-ai/dsh-webhook-github": "0.1.7-rc.2",
    "@deepseek-ai/schemastery": "~3.18.4",
    "pnpm": "10.32.1"
  }
}
